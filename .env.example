# Local development only. Copy to .env; never commit the copied file.
NODE_ENV=development

# Application
API_PORT=4040
WEB_PORT=3003
TEAM_PORT=3004
SERVICE_PORT=3005
ASSET_PORT=3006
MEDIA_PORT=3007
API_URL=http://localhost:4040
NEXT_PUBLIC_API_URL=http://localhost:4040
WEB_ORIGINS=http://localhost:3003,http://localhost:3004
ADMIN_EMAILS=admin@virtus.local

# Local infrastructure
POSTGRES_DB=virtus
POSTGRES_USER=virtus
POSTGRES_PASSWORD=virtus-local-only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://virtus:virtus-local-only@localhost:5432/virtus
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Replace this before any non-local deployment.
AUTH_SECRET=local-development-secret-change-me

# Public Docker/Nginx deployment
DEPLOY_BASE_DOMAIN=example.com
NGINX_HTTP_PORT=80
